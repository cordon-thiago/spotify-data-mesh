# Local development settings for the Postgres service.
# Copy to .env (git-ignored): cp .env.example .env
# The password is a local-only placeholder, not a real secret. Never reuse it elsewhere.
POSTGRES_USER=owner
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=spotify_mesh
POSTGRES_PORT=5432

# Passwords for the dbt and agent database roles, applied by `make roles` (Phase 2).
# Local-only placeholders; choose your own values in .env, different from POSTGRES_PASSWORD.
DBT_PASSWORD=change_me_local_only
AGENT_PASSWORD=change_me_local_only
